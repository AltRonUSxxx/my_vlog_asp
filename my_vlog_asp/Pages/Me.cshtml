@page
@model my_vlog_asp.Pages.MeModel
@{
}

<form method="post" asp-page-handler="Logout">
	<button class="liquid-card animate_hover mt-1 btn border-5 rounded-4" type="submit">
		Log out
	</button>
</form>
<div class="container big-text">
    <div class="animate_hover mt-5 liquid-phone rounded-5 border-0 w-100 mb-5 h-100">
		<a href="\editMe" class="ms-3 mt-2">
			✎
		</a>
        <h1 class=" ms-5">
            @Model.username · @Model.age y.o.
        </h1>
        <h2 class="ms-5 mt-2">
            @@<strong>@Model.login</strong>
        </h2>
        <p class="ms-5">
            Posts count: @Model.posts.Count
        </p>
		
        @if (@Model.posts.Count > 0)
        {
            <p class="ms-5">
                First post: @Model.firstPost.ToString("dd.MM.yy")
            </p>
        }
    </div>
</div>
<div class="row mt-5">
	<h3 class="justify-content-center mb-3 mt-5">
		Your posts
	</h3>
	@if (Model.posts.Count == 0)
	{
		<div class="justify-content-center alert alert-info">
			No posts yet
		</div>

	}
	else
	{
		@foreach (var post in Model.posts)
		{
			<div class="col-mb-6 mb-4">
				<div class="liquid-card animate_hover card mb-3 h-100 shadow-lg">
					<h4 class="mt-2 ms-2 card-title" @post.theme>@post.theme</h4>
					<p class="card-text ms-2">@post.text</p>
					<div class="ms-2 mb-2">
						@foreach (string tag in post.category.Split(' '))
						{
							<span class="badge bg-primary" 3>@tag</span>
						}
					</div>

					<div class="card-footer">
						<small class="d-block text-muted">
							@@@post.author_name
						</small>
						<small class="d-block text-muted">
							Created at: @post.created_at.ToString("dd.MM.yy");
						</small>
						<form method="post" asp-page-handler="UnPost" asp-route-post_id="@post.id">
							<button type="submit" class="btn btn-danger btn-sm">
								Delete
							</button>
						</form>
						@* <a asp-page="/ProjectDetails" asp-route-id="@post.id" class="liquid-card btn btn-sm">
								Открыть
							</a> *@
					</div>
				</div>
			</div>
		}
	}
</div>