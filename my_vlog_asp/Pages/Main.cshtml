@page
@model my_vlog_asp.Pages.HomeModel
@{
    ViewData["Title"] = "Главная";
}
<div class="container">
	<nav class="bg-opacity-100 navbar navbar-expand-lg border-bottom">
		<div class="container-fluid">

				<div class="d-flex flex-column flex-lg-row align-items-center w-100">
        
					<form class="w-75" method="post" asp-page-handler="Search">
						<input asp-for="whatFind" class="liquid-card animate_hover nice-form-control" placeholder="Search..." />
					</form>

				<div class="liquid-card animate_hover ms-auto mt-2">
					<a href="\makePost">
						<button class="btn " type="button">Make post</button>
					</a>
				</div>
			</div>

		</div>
	</nav>
	@if (Model.Posts.Count == 0)
	{
		<div class="justify-content-center alert alert-info">
			Пока актуальных постов нет.
		</div>
	}
	else
	{
		<div class="row">
			@foreach (var post in Model.Posts)
			{
				<div class="col-mb-6 mb-4">
					<div class="liquid-card animate_hover card mb-3 h-100 shadow-lg">
						<h4 class="mt-2 ms-2 card-title" @post.theme>@post.theme</h4>
						<p class="card-text ms-2">@post.text</p>
						<div class="ms-2 mb-2">
						@foreach (string tag in post.category.Split(' '))
						{
							<span class="badge bg-primary"3>@tag</span>
						}
						</div>

						<div class="card-footer">
							<small class="d-block text-muted">
								
							</small>
							<small class="d-block text-muted">
								Дата создание: @post.created_at.ToString("dd.MM.yy");
							</small>
							<a asp-page="/ProjectDetails" asp-route-id="@post.id" class="liquid-card btn btn-sm">
								Открыть
							</a>
						</div>
					</div>
				</div>
			}
		</div>
	}

</div>